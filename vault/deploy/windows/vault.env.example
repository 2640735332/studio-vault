# Vault runtime env template for the optional Windows deployment.
# Copy to <VaultHome>\vault.env and fill values; keep the file ACL restricted to SYSTEM+Administrators.
# The paths below assume the default VaultHome C:\vault; adjust them if you deploy elsewhere.
# ASCII only: the scheduled task / run.bat chain is more robust without non-ASCII text.

VAULT_BIND=0.0.0.0
VAULT_PORT=3460
VAULT_DATA_DIR=C:\vault\data
VAULT_LOG_LEVEL=info

# Metadata store. Point this at a local PostgreSQL service (or the compose stack on the Linux host);
# memory is only acceptable for a smoke test.
VAULT_DB=pg
VAULT_PG_HOST=127.0.0.1
VAULT_PG_PORT=5432
VAULT_PG_USER=vault
VAULT_PG_PASSWORD=change-me
VAULT_PG_DB=vault
VAULT_MIGRATE_ON_START=1
VAULT_DEV_SEED=0

# Backup output directory (see windows/backup.ps1)
VAULT_BACKUP_DIR=C:\vault\data\backup
VAULT_BACKUP_KEEP=14

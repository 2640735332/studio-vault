# Vault compose environment template. Copy to deploy/.env and fill real values.
# NEVER commit .env (contains passwords). Tokens live in the user's credential store or the
# /api/v1/tokens admin endpoint, never in this file.

VAULT_PG_USER=vault
VAULT_PG_PASSWORD=change-me-postgres
VAULT_PG_DB=vault
VAULT_PG_BIND=127.0.0.1

VAULT_MINIO_USER=vault
VAULT_MINIO_PASSWORD=change-me-minio
VAULT_MINIO_BUCKET=vault
VAULT_MINIO_BIND=127.0.0.1

VAULT_OS_BIND=127.0.0.1
VAULT_BIND=0.0.0.0
VAULT_LOG_LEVEL=info
TZ=Asia/Shanghai

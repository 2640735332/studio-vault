# Vault API environment template (server process). Copy to your deployment env file and fill.
# In compose the values are injected by deploy/docker-compose.yml; on Windows they come from the
# deployment env file (see deploy/windows/vault.env.example).

VAULT_BIND=127.0.0.1
VAULT_PORT=3460

# Storage driver: "pg" (production) or "memory" (local dev / selftest, non-durable).
VAULT_DB=memory

# PostgreSQL (when VAULT_DB=pg). DATABASE_URL=postgres://user:pass@host:port/db also works.
VAULT_PG_HOST=127.0.0.1
VAULT_PG_PORT=5432
VAULT_PG_USER=vault
VAULT_PG_PASSWORD=
VAULT_PG_DB=vault

# Directories and runtime behaviour
# VAULT_DATA_DIR defaults to ~/.studio/vault/data when empty; use an absolute path in production.
VAULT_DATA_DIR=
VAULT_LOG_LEVEL=info
VAULT_MIGRATE_ON_START=1
VAULT_DEV_SEED=0
VAULT_READONLY=0

# Object storage / full-text search wiring; accepted today, consumed by ingest/search.
VAULT_MINIO_ENDPOINT=
VAULT_MINIO_BUCKET=vault
VAULT_OPENSEARCH_URL=

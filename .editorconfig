# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,mjs,cjs}]
indent_size = 4

[*.{json,jsonc,yml,yaml}]
indent_size = 2

# Markdown keeps hard line breaks / trailing spaces meaningful.
[*.md]
trim_trailing_whitespace = false
indent_size = unset

# Deployment scripts are examples and follow their platform conventions.
[*.{ps1,bat,cmd,sh}]
indent_size = 2

[*.sql]
indent_size = 2

      "bin": {
        "studio-cli": "bin/studio-cli.js"
      },
      "engines": {
        "node": ">=22.5"
      }
    },
    "packages/shared": {
      "name": "@studio/shared",
      "version": "0.1.18",
      "license": "MIT",
      "engines": {
        "node": ">=22.5"
      }
    },
    "packages/studio": {
      "name": "@studio/local",
      "version": "0.1.18",
      "license": "MIT",
      "dependencies": {
        "@studio/shared": "0.1.18"
      },
      "bin": {
        "studio": "bin/studio.js"
      },
      "engines": {
        "node": ">=22.5"
      }
    }
  }
}

{
  "name": "studio-vault",
  "version": "0.1.18",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "studio-vault",
      "version": "0.1.18",
      "license": "MIT",
      "workspaces": [
        "packages/shared",
        "packages/studio",
        "packages/cli"
      ],
      "engines": {
        "node": ">=22.5"
      }
    },
    "node_modules/@studio/cli": {
